# Salin berkas ini menjadi .env lalu isi dengan nilai asli.
# .env TIDAK BOLEH di-commit — berisi kredensial basis data rekam medis.
#
# Produksi (VPS sundy): .env ada di /www/sundy/shared/.env, dibuat langsung di
# server dan hanya bisa dibaca user "sundyapp". Kedua URL menunjuk PostgreSQL 18
# lokal server dan bernilai sama. Lihat docs/operasional/server-sundy.md.
#
# Pengembangan di laptop: PostgreSQL 18 lokal (lihat README), basis data
# sundy_dev untuk aplikasi dan sundy_test untuk uji.

# Dipakai runtime aplikasi.
DATABASE_URL="postgresql://sundy@localhost:5432/sundy_dev"
# Dipakai prisma migrate & seed. Di PostgreSQL biasa nilainya sama dengan DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://sundy@localhost:5432/sundy_dev"

# Basis data uji — dipakai uji integrasi & e2e. Tabelnya dikosongkan berulang
# kali, jadi JANGAN PERNAH mengarahkannya ke basis data yang sama dengan DATABASE_URL.
TEST_DATABASE_URL="postgresql://sundy@localhost:5432/sundy_test"
TEST_DATABASE_URL_UNPOOLED="postgresql://sundy@localhost:5432/sundy_test"

# URL situs. Produksi: https://sundyclinic.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Better Auth — hasilkan dengan: openssl rand -base64 32
BETTER_AUTH_SECRET="ganti-dengan-secret-32-karakter-atau-lebih"
BETTER_AUTH_URL="http://localhost:3000"

# Folder file pasien (hasil BIA, scan rekam medis lama). Di luar web root dan
# hanya dibuka lewat aplikasi. Produksi: /www/sundy-files
PATIENT_FILES_DIR="/www/sundy-files"

# Jeda sementara pendaftaran online /daftar (mis. saat fitur booking sedang
# diperbaiki): isi "true" di shared/.env lalu `pm2 restart sundy`, tanpa deploy.
# Kosongkan atau hapus untuk membuka lagi.
REGISTRATION_CLOSED="false"
