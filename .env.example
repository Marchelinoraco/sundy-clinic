# Salin berkas ini menjadi .env lalu isi dengan nilai asli.
# .env TIDAK BOLEH di-commit — berisi kredensial basis data rekam medis.
#
# Nilai untuk branch "production" paling mudah diambil dengan:
#   neon link --project-id <project-id> --branch production
# Perintah itu menulis DATABASE_URL, DATABASE_URL_UNPOOLED, dan NEON_BRANCH
# ke .env secara otomatis.

# --- Dikelola Neon. Ditimpa otomatis oleh `neon env pull` dan `neon deploy`. ---

# Branch "production" — dipakai aplikasi dan pengembangan.
# Endpoint POOLED (hostname mengandung "-pooler"): dipakai runtime aplikasi.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Endpoint LANGSUNG (tanpa "-pooler"): dipakai prisma migrate.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH="production"

# --- Dikelola manual. ---

# Branch "test" — dipakai uji integrasi. Tabelnya dikosongkan berulang kali,
# jadi JANGAN PERNAH mengarahkan dua nilai ini ke branch production.
# Ambil dengan: neon connection-string test --pooled   (dan tanpa --pooled)
TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-yyyy-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
TEST_DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-yyyy.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# URL situs. Saat tayang, isi dengan domain sebenarnya agar peta situs benar.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
